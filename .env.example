# Copiar este archivo como .env y completar los valores.
# .env está en .gitignore: NUNCA subir credenciales reales al repositorio.

# Dominio interno de la tienda (no el dominio público)
SHOPIFY_SHOP_DOMAIN=mi-tienda.myshopify.com
SHOPIFY_API_VERSION=2026-10

# API para leer pedidos: graphql (recomendada) o rest (respaldo si GraphQL fallara)
SHOPIFY_API=graphql

# Autenticación DEFINIDA para Luisa Chimá: Client Credentials (app del Dev Dashboard).
# El pipeline pide el token y lo renueva solo (dura ~24 h).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Aviso por correo de la corrida diaria (Gmail / Google Workspace) ---
# Vacío = sin avisos. La clave es una CONTRASEÑA DE APLICACIÓN de Google (16 letras), no la
# contraseña normal: https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
NOTIFICAR_A=
SMTP_USUARIO=
SMTP_CLAVE=
