# Copiar este archivo como .env y completar los valores.
# .env está en .gitignore: NUNCA subir credenciales reales al repositorio.

# Dominio interno de la tienda (no el dominio público)
SHOPIFY_SHOP_DOMAIN=mi-tienda.myshopify.com
SHOPIFY_API_VERSION=2026-10

# Autenticación DEFINIDA para Luisa Chimá: Client Credentials (app del Dev Dashboard).
# El pipeline pide el token y lo renueva solo (dura ~24 h).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Solo para una custom app legacy (token permanente shpat_...). NO se usa en Luisa Chimá.
# Déjela comentada: si se define, tiene prioridad sobre Client Credentials.
# SHOPIFY_ACCESS_TOKEN=

# --- Reporte Siesa ---
# Referencia del ítem de envío en Siesa (R-08)
SIESA_CODIGO_ENVIO=SERV01
