# Copiar este archivo como .env y completar los valores.
# .env está en .gitignore: NUNCA subir credenciales reales al repositorio.

# Dominio interno de la tienda (no el dominio público)
SHOPIFY_SHOP_DOMAIN=mi-tienda.myshopify.com
SHOPIFY_API_VERSION=2026-10

# Opción A (recomendada): app creada en el Dev Dashboard (apps nuevas desde 1-ene-2026)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Opción B: custom app legacy creada antes de 2026 (token permanente shpat_...)
# Si se define, tiene prioridad sobre la opción A.
# SHOPIFY_ACCESS_TOKEN=

# --- Reporte Siesa ---
# Referencia del ítem de envío en Siesa (pendiente de confirmar con Siesa)
SIESA_CODIGO_ENVIO=ENVIO
